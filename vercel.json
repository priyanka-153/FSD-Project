{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/uploads/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "frontend" }
    }
  ]
}
